APP_NAME="Умный Двор"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Copy to .env.testing, then run ./x artisan key:generate --env=testing --no-interaction.
# Create this dedicated database once on the local PostgreSQL service:
# ./x artisan tinker --execute 'DB::statement("CREATE DATABASE saas_test_testing");' --no-interaction
# phpunit.xml fixes the driver/database and clears DB_URL to protect the application database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saas_test_testing
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
